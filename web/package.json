{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen:types": "node scripts/gen-types.mjs",
		"data": "node scripts/data.mjs",
		"browser-check": "node scripts/browser-check.mjs",
		"visual-check": "node scripts/visual-check.mjs",
		"notation-check": "node scripts/notation-check.mjs",
		"slow-check": "node scripts/slow-check.mjs",
		"rate-check": "node scripts/rate-check.mjs",
		"spectro-check": "node scripts/spectro-check.mjs",
		"sampler-check": "node scripts/sampler-check.mjs",
		"deploy-check": "node scripts/deploy-check.mjs",
		"smoke-check": "node scripts/smoke-check.mjs",
		"perf-check": "node scripts/perf-check.mjs",
		"soak-check": "node scripts/soak-check.mjs",
		"release-check": "node scripts/release-check.mjs",
		"a11y-check": "node scripts/a11y-check.mjs",
		"flash-check": "node scripts/flash-check.mjs",
		"scenes-check": "node scripts/scenes-check.mjs",
		"ambient-check": "node scripts/ambient-check.mjs",
		"player-check": "node scripts/player-check.mjs",
		"ambient-presets": "node scripts/ambient-presets.mjs",
		"ambient-curate": "node scripts/ambient-curate.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/three": "^0.187.0",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"json-schema-to-typescript": "^16.0.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"verovio": "^6.4.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"butterchurn": "^2.6.7",
		"butterchurn-presets": "^2.4.7",
		"three": "^0.187.0"
	}
}
